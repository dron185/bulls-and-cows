{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "tsc && cpx \"*.{html,css}\" dist",
    "watch:static": "cpx \"*.{html,css}\" dist -w",
    "serve": "live-server dist",
    "dev": "concurrently \"tsc -w\" \"npm run watch:static\" \"npm run serve\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "cpx": "^1.5.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "live-server": "^1.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  }
}
